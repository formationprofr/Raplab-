<script>
  document.getElementById("year").textContent = new Date().getFullYear();

  function showPage(page, target) {
    const home = document.getElementById("homePage");
    const program = document.getElementById("programPage");

    home.classList.toggle("active", page === "home");
    program.classList.toggle("active", page === "program");

    closeModal("loginModal");
    closeModal("subscribeModal");

    if (target && page === "home") {
      setTimeout(() => {
        const element = document.getElementById(target);
        if (element) element.scrollIntoView({ behavior: "smooth", block: "start" });
      }, 40);
    } else {
      window.scrollTo({ top: 0, behavior: "smooth" });
    }
  }

  function openModal(id) {
    document.getElementById(id).classList.add("open");
  }

  function closeModal(id) {
    document.getElementById(id).classList.remove("open");
  }

  function backdropClose(event, id) {
    if (event.target.id === id) closeModal(id);
  }

  function demoLogin(event) {
    event.preventDefault();
    document.getElementById("loginNotice").textContent =
      "La connexion n'est pas encore activée : aucun compte n'a été créé ni vérifié.";
  }

  document.addEventListener("keydown", function(event) {
    if (event.key === "Escape") {
      closeModal("loginModal");
      closeModal("subscribeModal");
    }
  });
</script>

</body>
</html>
