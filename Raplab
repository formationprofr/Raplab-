
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Rap Lab — Passe au niveau supérieur</title>
  <meta name="description" content="Rap Lab : une plateforme de formation rap pour progresser en écriture, flow, topline et enregistrement.">
  <style>
    :root {
      --bg: #090912;
      --panel: #131323;
      --panel2: #1b1a30;
      --purple: #8b5cf6;
      --pink: #d946ef;
      --text: #f6f4ff;
      --muted: #aaa7c2;
      --border: rgba(255,255,255,.1);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    html { scroll-behavior: smooth; }

    body {
      font-family: Inter, system-ui, Arial, sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.6;
    }

    button, a { font: inherit; }
    a { color: inherit; text-decoration: none; }
    button { cursor: pointer; }

    .container { width: min(1120px, 92%); margin: auto; }

    header {
      position: sticky;
      top: 0;
      z-index: 10;
      background: rgba(9,9,18,.9);
      backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--border);
    }

    .nav {
      min-height: 76px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
    }

    .logo { font-size: 1.4rem; font-weight: 900; letter-spacing: -1px; }
    .logo span { color: var(--pink); }

    .nav-links { display: flex; align-items: center; gap: 22px; }
    .nav-links a:not(.btn) { color: var(--muted); }
    .nav-links a:hover { color: white; }

    .btn {
      border: 0;
      border-radius: 12px;
      padding: 12px 18px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      font-weight: 800;
      transition: .2s;
    }

    .btn:hover { transform: translateY(-2px); filter: brightness(1.12); }

    .primary {
      color: white;
      background: linear-gradient(110deg, var(--purple), var(--pink));
      box-shadow: 0 8px 28px #8b5cf633;
    }

    .secondary {
      color: white;
      background: var(--panel2);
      border: 1px solid var(--border);
    }

    .hero {
      padding: 100px 0 85px;
      overflow: hidden;
      background:
        radial-gradient(ellipse at 80% 20%, #7c3aed25, transparent 45%),
        radial-gradient(ellipse at 20% 80%, #d946ef15, transparent 40%);
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 1.15fr .85fr;
      align-items: center;
      gap: 50px;
    }

    .eyebrow {
      color: #d8b4fe;
      font-weight: 800;
      text-transform: uppercase;
      font-size: .78rem;
      letter-spacing: 2px;
      margin-bottom: 18px;
    }

    h1 {
      font-size: clamp(2.8rem, 6vw, 5rem);
      line-height: 1.02;
      letter-spacing: -3px;
      margin-bottom: 24px;
    }

    .gradient-text {
      background: linear-gradient(90deg, #c4b5fd, #f0abfc);
      color: transparent;
      background-clip: text;
      -webkit-background-clip: text;
    }

    .hero p, .section-intro {
      color: var(--muted);
      font-size: 1.08rem;
      max-width: 640px;
    }

    .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }

    .hero-card {
      padding: 28px;
      border: 1px solid var(--border);
      border-radius: 24px;
      background: linear-gradient(145deg, #1e1b36, #11111e);
      box-shadow: 0 30px 100px #0005;
      transform: rotate(1deg);
    }

    .hero-card h3 { font-size: 1.3rem; margin: 12px 0; }
    .hero-card p { font-size: .95rem; }
    .hero-icon { font-size: 3rem; }

    .stat-row { display: grid; grid-template-columns: repeat(3,1fr); gap: 10px; margin-top: 25px; }
    .stat { background: #ffffff08; border: 1px solid var(--border); border-radius: 13px; padding: 13px; }
    .stat strong { display: block; font-size: 1.2rem; }
    .stat span { font-size: .75rem; color: var(--muted); }

    section { padding: 82px 0; }
    .section-heading { margin-bottom: 32px; }
    .section-heading h2 { font-size: clamp(2rem, 4vw, 3rem); letter-spacing: -1px; margin-bottom: 10px; }
    .section-heading p { color: var(--muted); max-width: 650px; }

    .cards { display: grid; grid-template-columns: repeat(3,1fr); gap: 18px; }

    .card {
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 18px;
      padding: 24px;
      transition: .2s;
    }

    .card:hover { transform: translateY(-4px); border-color: #8b5cf688; }
    .card-icon { font-size: 1.8rem; margin-bottom: 14px; }
    .card h3 { margin-bottom: 9px; font-size: 1.12rem; }
    .card p { color: var(--muted); font-size: .94rem; }
    .card-link { display: inline-block; margin-top: 18px; color: #d8b4fe; font-weight: 800; }

    .premium-banner {
      margin-top: 28px;
      padding: 26px;
      border-radius: 20px;
      background: linear-gradient(110deg, #6d28d9, #a21caf);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }

    .premium-banner p { color: #f3e8ff; }

    .pricing-wrap { max-width: 780px; margin: auto; text-align: center; }

    .pricing-card {
      margin-top: 30px;
      padding: 36px;
      border-radius: 24px;
      border: 1px solid #a78bfa66;
      background:
        radial-gradient(circle at top right, #8b5cf625, transparent 40%),
        var(--panel);
      text-align: left;
    }

    .price { font-size: 3.5rem; font-weight: 900; letter-spacing: -2px; }
    .price small { font-size: 1rem; color: var(--muted); font-weight: 500; letter-spacing: 0; }
    .features { list-style: none; margin: 24px 0; }
    .features li { margin: 12px 0; color: #e8e4f7; }
    .features li::before { content: "✓"; color: #c4b5fd; font-weight: 900; margin-right: 10px; }
    .pricing-card .btn { width: 100%; }
    .fine-print { color: var(--muted); font-size: .82rem; margin-top: 13px; }

    .faq { max-width: 800px; margin: auto; }
    details { padding: 20px 0; border-bottom: 1px solid var(--border); }
    summary { cursor: pointer; font-weight: 800; }
    details p { color: var(--muted); padding-top: 12px; }

    footer { border-top: 1px solid var(--border); padding: 30px 0; color: var(--muted); }
    .footer-row { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 15px; }

    .page { display: none; }
    .page.active { display: block; }

    .page-hero { padding: 65px 0 30px; }
    .module-detail { margin-bottom: 20px; }
    .module-detail p { margin-top: 10px; }
    .tag {
      display: inline-block;
      border: 1px solid #a78bfa66;
      color: #d8b4fe;
      padding: 4px 10px;
      border-radius: 999px;
      font-size: .76rem;
      margin-bottom: 12px;
    }

    .modal-backdrop {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 30;
      background: #000b;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .modal-backdrop.open { display: flex; }

    .modal {
      width: min(440px, 100%);
      background: #151426;
      border: 1px solid var(--border);
      border-radius: 22px;
      padding: 28px;
      position: relative;
    }

    .modal h2 { margin-bottom: 8px; }
    .modal p { color: var(--muted); margin-bottom: 18px; }
    .modal input {
      width: 100%;
      background: #0b0b16;
      border: 1px solid var(--border);
      color: white;
      padding: 13px;
      border-radius: 10px;
      margin-bottom: 12px;
    }

    .modal .btn { width: 100%; }
    .close-modal {
      position: absolute;
      top: 12px;
      right: 14px;
      background: transparent;
      color: white;
      border: 0;
      font-size: 1.5rem;
    }

    .notice { font-size: .83rem; color: #d8b4fe; margin-top: 14px; }

    @media (max-width: 760px) {
      .hero-grid { grid-template-columns: 1fr; }
      .hero { padding: 65px 0; }
      .hero-card { transform: none; }
      .cards { grid-template-columns: 1fr; }
      .nav-links { gap: 10px; }
      .nav-links a:not(.btn) { display: none; }
      .premium-banner { align-items: flex-start; flex-direction: column; }
      .pricing-card { padding: 25px; }
      h1 { letter-spacing: -2px; }
    }
  </style>
</head>
